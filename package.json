{
  "name": "shen-zhiyi-interactive-movie",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:app": "uni -p app",
    "validate:story": "node scripts/validate-story.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "assets:audit": "node scripts/audit-ui-assets.mjs",
    "audit:assets": "node scripts/audit-ui-assets.mjs",
    "assets:extract": "node scripts/extract-ui-assets.mjs",
    "story:studio": "vite --config story-studio/vite.config.mjs",
    "story:check": "node scripts/build-studio-story.mjs --check",
    "story:publish": "node scripts/build-studio-story.mjs",
    "story:build": "vite build --config story-studio/vite.config.mjs",
    "story:test": "node scripts/test-studio-story.mjs",
    "test:skins": "node scripts/test-skins.mjs",
    "build:douyin": "node scripts/build-douyin.mjs",
    "dev:douyin": "npm run build:douyin && vite --config douyin/preview/vite.config.mjs",
    "check:douyin": "node scripts/check-douyin.mjs",
    "typecheck:douyin": "tsc --noEmit -p douyin/tsconfig.json",
    "test:douyin": "node scripts/test-douyin.mjs",
    "verify:base": "npm run validate:story && npm run story:test && npm run test:skins && npm run typecheck:douyin && npm run build:h5 && npm run build:douyin && npm run test:douyin"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/runtime-core": "^3.4.21",
    "esbuild": "^0.20.2",
    "sass": "^1.80.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vite": "5.2.8"
  }
}
